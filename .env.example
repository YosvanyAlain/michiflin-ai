# Access (required)
OWNER_ONLY=1
INVITE_AUTO_ACCESS=0  # opt-in with OWNER_ONLY=0: completed private SecureJoin grants ordinary access
BOT_EPOCH=  # stable opaque deployment ID; don't rotate casually
BOT_EPOCH_STRICT=0  # enable only after a verified new-identity cutover
BOT_VERIFIED_CONTACTS_ONLY=0  # enable with a verified owner key on the new account
OWNER_PGP_FINGERPRINT=  # owner's PUBLIC primary OpenPGP fingerprint, independently verified; never a private key
OWNER_ADDRESS=you@example.org
OWNER_BACKUP_ADDRESS=  # optional explicitly configured backup administrator
EMAIL_KEY_RECOVERY=0  # 1 trusts permitted email addresses on key change: susceptible to spoofing
MAINTENANCE_MODE=0  # 1 restricts access to the configured administrators
# Initial defaults only: a saved per-person value takes precedence.
NAUTA_STRICT=0
KILL_SWITCH=0
# Optional exact-address limits, only after verification; never inferred from domain. No credentials.
# Fields: safe_part_mb, min_delay_seconds, max_batch_parts, daily_cap_mb; verified profiles also require source and checked_at.
MAILBOX_PROFILES_JSON=
ALLOWED_SENDERS=  # ignored for guest access in private/maintenance or invitation mode

# Optional one-time message shown in the owner's app
OWNER_NOTICE=

# AI providers: free tiers only, one key per provider (all optional)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Conservative local estimate only; use a Workers Free account as the hard billing limit.
CLOUDFLARE_ESTIMATED_NEURONS=7500
# Anonymous OVH SDXL, currently free and rate limited; set 0 to disable.
OVH_IMAGES=1
GITHUB_MODELS_TOKEN=
POLLINATIONS_API_KEY=
BAZAARLINK_API_KEY=
ORCAROUTER_API_KEY=
SAMBANOVA_API_KEY=
# Keyless providers (OVH anonymous, LLM7, Kilo); 0 disables all three.
# OVH text always uses anonymous access, never a paid OVH API key.
FREE_GATEWAYS=1
LLM7_API_KEY=
KILO_API_KEY=
# Public HF Space works anonymously; an optional token uses its account's quota/settings.
HF_IMAGES=1
HF_TOKEN=
HF_IMAGE_SPACE=black-forest-labs/FLUX.1-schnell
YDC_API_KEY=
YDC_DAILY=90
# AI Horde volunteer GPUs (keyless); a free registered key earns queue priority; 0 disables
AI_HORDE=1
AI_HORDE_API_KEY=
# Coder runs project commands in an isolated sandbox (needs passwordless sudo and util-linux); 0 only writes files
CODE_RUN=1
# Keyless public image fallback; set 0 to disable
POLLINATIONS_PUBLIC=1
# JSON list of extra OpenAI-compatible free providers (see README)
EXTRA_PROVIDERS=
AI_EXTRA_ALLOWED_HOSTS=  # comma-separated exact HTTPS hostnames trusted for custom API keys
AI_TIMEOUT=75
AI_MAX_OUTPUT_TOKENS=6000

# Optional services
# Current elTOQUE rates and history require an authorized application token.
# Store it as a secret; the bot does not scrape the website as a fallback.
ELTOQUE_API_TOKEN=
# One shared refresh for all users, 120–3600 seconds (default 300).
ELTOQUE_REFRESH_SECONDS=300
# Enable only after elTOQUE explicitly authorizes derived calculations/scenarios.
ELTOQUE_DERIVED_CALCULATIONS=0
# Optional trusted LibreTranslate HTTPS endpoint, used only if the primary
# translator is unavailable. The provider receives the text and may have limits.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Independent rule-based fallback; beta pairs and service limits may change.
# All providers receive submitted text, so do not translate secrets.
APERTIUM_ENABLED=1
APERTIUM_URL=https://beta.apertium.org/apy
MICHIFLIN_GITHUB_TOKEN=
# Optional individual read-only social API connections; no web passwords/cookies.
# Provider apps, approvals and individual consent are required. See docs/WEB_ACCESS.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
FACEBOOK_READ_POSTS=0  # enable only after Meta approves user_posts
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=  # exact registered HTTPS redirect; no query or fragment
TIKTOK_READ_VIDEOS=0  # enable only after TikTok approves video.list
WEB_SESSION_KEY=  # separate random secret of at least 32 characters; keep stable

# Optional network helpers. Live/private media use WEB_PROXY, or MEDIA_PROXY
# when WEB_PROXY is empty. Supported upstreams: socks5, socks5h, http CONNECT.
# An unavailable configured proxy fails closed rather than silently using direct.
MEDIA_PROXY=
WEB_PROXY=
YTDLP_COOKIES=

# Encrypted state backup (state_backup.py)
GITHUB_TOKEN=
STATE_BACKUP_REPO=
STATE_BACKUP_REQUIRED=0  # set to 1 after the first encrypted backup exists
STATE_BACKUP_ALLOW_EMPTY=0  # one-time first-install escape hatch only
STATE_BACKUP_PASSPHRASE=
STATE_BACKUP_PATH=michiflin-state.bin
STATE_BACKUP_BRANCH=main
STATE_BACKUP_STORAGE=releases  # verified bounded assets; legacy-git is rollback-only

# Runtime
CONFIG_DIR=./state
BOT_TIMEZONE=America/Havana
SESSION_DURATION_SECONDS=19200
JOB_DIR=/tmp/michiflin-queue
PREVIEW_DIR=/tmp/michiflin-temp

# Limits (disk space is also checked live)
MAX_FILE_MB=4096
MAX_QUEUE_MB=12288
MIN_FREE_DISK_MB=1536
MAX_DURATION_MINUTES=0
MAX_WEB_PREVIEW_MB=8
MAX_AI_DOCUMENT_MB=20
MAX_AI_DOCUMENT_CHARS=60000
MAX_AI_DOCUMENT_PAGES=60

# Defaults the owner can change from chat with /ajustes
LANGUAGE_MODE=auto
AUTONOMY_MODE=balanced
DEFAULT_VIDEO_HEIGHT=360
DEFAULT_AUDIO_KBPS=64
DEFAULT_AUDIO_FORMAT=m4a
CHUNK_MB=20
PART_FORMAT=raw
DEFAULT_BATCH_COUNT=0
DEFAULT_SEND_DELAY_SECONDS=15
SEND_WINDOW=
AUTO_SEND=1
MAIL_SAFETY_CAP_MB=0
READER_IMAGES=off
READER_PAGE_KB=120
READER_LINKS=chat
CAPTURE_DEVICE=mobile
CAPTURE_QUALITY=high
NOTIFY_MODE=minimal
PROGRESS_MODE=on
# Reactions on owner messages: on (slow tasks), off, all (also 👀 on arrival).
REACTIONS_MODE=on
STATUS_DELAY=4
STATUS_EDIT_SECONDS=12
STATUS_MAX_EDITS=30
IMAGE_SIZE=768
JOB_TTL_HOURS=48
